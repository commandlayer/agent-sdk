{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandlayer.org/schemas/trust-receipt-v1.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "trust-request-v1"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof"
      ],
      "properties": {
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical",
            "alg",
            "signature",
            "kid",
            "signer_id"
          ],
          "properties": {
            "canonical": {
              "const": "json.sorted_keys.v1"
            },
            "alg": {
              "type": "string",
              "enum": ["ed25519"]
            },
            "signature": {
              "type": "string",
              "minLength": 16,
              "pattern": "^[A-Za-z0-9+/=]+$"
            },
            "kid": {
              "type": "string",
              "minLength": 1
            },
            "signer_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
