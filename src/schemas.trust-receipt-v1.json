{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandlayer.org/schemas/trust-receipt-v1.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "trust-request-v1"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof"
      ],
      "properties": {
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalization",
            "hash",
            "signature_alg",
            "signature",
            "key_id",
            "signer"
          ],
          "properties": {
            "canonicalization": {
              "const": "json.sorted_keys.v1"
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "signature_alg": {
              "const": "ed25519"
            },
            "signature": {
              "type": "string",
              "minLength": 16,
              "pattern": "^[A-Za-z0-9+/=]+$"
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "signer": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
